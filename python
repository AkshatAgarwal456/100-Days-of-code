      "source": [
        "# Program to print Fibonacci series up to n terms\n",
        "\n",
        "n = int(input(\"Enter number of terms: \"))\n",
        "\n",
        "a = 0\n",
        "b = 1\n",
        "\n",
        "print(\"Fibonacci series:\")\n",
        "\n",
        "for i in range(n):\n",
