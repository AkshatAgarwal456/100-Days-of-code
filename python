        "# Program to print the given pattern\n",
        "\n",
        "n = 5\n",
        "\n",
        "for i in range(n):\n",
        "    # Left numbers\n",
        "    for j in range(1, n - i + 1):\n",
        "        print(j, end=\"\")\n",
        "\n",
        "    # Spaces between numbers and stars\n",
        "    print(\" \" * i, end=\"\")\n",
        "\n",
        "    # Stars\n",
        "    if i > 0:\n",
        "        print(\"* \" * i, end=\"\")\n",
        "\n",
        "    # Spaces after stars\n",
        "    print(\" \" * i, end=\"\")\n",
        "\n",
        "    # Right numbers\n",
        "    for j in range(n - i, 0, -1):\n",
        "        print(j, end=\"\")\n",
        "\n",
        "    print()\n"
