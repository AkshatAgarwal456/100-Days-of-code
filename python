          "base_uri": "https://localhost:8080/"
        }
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Enter a number: 98\n",
            "Not an Armstrong Number\n"
          ]
        }
      ],
      "source": [
        "# Program to check Armstrong number\n",
        "\n",
        "num = int(input(\"Enter a number: \"))\n",
        "\n",
        "temp = num\n",
        "sum = 0\n",
        "digits = len(str(num))\n",
        "\n",
        "while temp > 0:\n",
        "    rem = temp % 10\n",
        "    sum = sum + (rem ** digits)\n",
        "    temp = temp // 10\n",
        "\n",
        "if sum == num:\n",
        "    print(\"Armstrong Number\")\n",
        "else:\n",
        "    print(\"Not an Armstrong Number\")\n"
      ]
