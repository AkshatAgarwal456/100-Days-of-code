      "source": [
        "# Program to check palindrome number\n",
        "\n",
        "num = int(input(\"Enter a number: \"))\n",
        "\n",
        "temp = num\n",
        "rev = 0\n",
        "\n",
        "while temp > 0:\n",
        "    rem = temp % 10\n",
        "    rev = rev * 10 + rem\n",
        "    temp = temp // 10\n",
        "\n",
        "if rev == num:\n",
        "    print(\"Palindrome Number\")\n",
        "else:\n",
        "    print(\"Not a Palindrome Number\")\n"
